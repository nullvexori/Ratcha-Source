DISCORD_TOKEN=PUT_YOUR_BOT_TOKEN_HERE
CLIENT_ID=PUT_YOUR_APPLICATION_ID_HERE

# Recommended while testing: commands update instantly in this server.
# Leave blank to deploy globally instead.
GUILD_ID=PUT_YOUR_TEST_SERVER_ID_HERE

# Your requested default logging channel.
LOG_CHANNEL_ID=PUT_YOUR_LOG_CHANNEL_ID_HERE

# Comma-separated Discord user IDs allowed to use owner-only commands.
OWNER_IDS=PUT_YOUR_USER_ID_HERE

# Public URL of the Mocha server. The bot reads RecNet's public JSON APIs.
MOCHA_API_URL=https://playmocha.xyz

# Optional separate public website URL. Defaults to MOCHA_API_URL.
MOCHA_RECNET_URL=https://playmocha.xyz
